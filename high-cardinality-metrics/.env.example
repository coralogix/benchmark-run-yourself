# Copy to .env and fill in. Never commit .env.
# One comment line above each variable; keep values free of trailing spaces.

# --- AWS
# Region for every resource (needs m7g instances).
AWS_REGION=
# Optional AWS CLI profile. Uncomment to use one; otherwise default credentials apply.
# AWS_PROFILE=
# S3 bucket for code, coordination markers, the corpus and Mimir blocks (make setup creates it).
BENCH_BUCKET=
# Run tag on every instance and the S3 prefix for the code; make run adds a UTC timestamp to it for each run.
RUN_TAG=hcm-bench
# Your public IP as a /32, allowed to reach the boxes.
OPERATOR_CIDR=
# arm64 Amazon Linux 2023 AMI in AWS_REGION.
AMI_ID=
# VPC to run in.
VPC_ID=
# Subnet in that VPC with outbound internet access.
SUBNET_ID=
# First three octets of addresses inside SUBNET_ID, e.g. 10.0.4; <prefix>.11 to <prefix>.32 must be free.
PRIVATE_IP_PREFIX=
# test = small rehearsal, real = the full one-week run.
SCALE=test
# 1 = mount the corpus stored in BENCH_BUCKET and skip the ingest (ClickHouse TimeSeries is then left out); 0 = load everything.
REUSE=0

# --- Coralogix
# Secrets Manager secret name; make setup writes the three values below into it.
CX_SECRET_ID=
# Send-Your-Data API key, used to ingest the corpus.
CX_SEND_KEY=
# API key with metrics query access, used by the query client.
CX_API_KEY=
# Your Coralogix domain: the part after "api." in your API URL.
CX_DOMAIN=

# --- Manual runs of harness/run.py only (infra/stage.sh sets these on the query clients)
# https://api.<CX_DOMAIN>/metrics/api/v1
CX_PROMQL=
# http://<mimir-node>:8080/prometheus/api/v1
MIMIR_PROMQL=
# Comma-separated PromQL base URLs of every Mimir node, queried round-robin.
MIMIR_NODES=
# Counter name template on Mimir (loaded from Prometheus blocks).
MIMIR_COUNTER_NAME=http_requests_{band}_total
# PromQL base URL of Prometheus (http://<host>:9090/api/v1) or ClickHouse TimeSeries (http://<host>:8123/prometheus/api/v1).
PROM_PROMQL=
# Counter name template for PROM_PROMQL; leave empty for Prometheus, http_requests_total_{band} for ClickHouse TimeSeries.
PROM_COUNTER_NAME=
# ClickHouse MergeTree HTTP interface, e.g. http://<host>:8123
CH_HTTP=
# Unix seconds inside the loaded week; every platform is queried at this instant.
QUERY_EVAL_TIME=
