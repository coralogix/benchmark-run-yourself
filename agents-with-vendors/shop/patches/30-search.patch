+# Benchmark: product search for the search relevance scenario. agents/ops.sh
+# dc includes this file. frontend-proxy routes /api/search here and the load
+# generator's search_products task calls it.
+services:
+  search:
+    image: harness-search:1
+    container_name: search
+    build:
+      context: ./
+      dockerfile: ./src/search/Dockerfile
+    deploy:
+      resources:
+        limits:
+          memory: 120M
+    restart: unless-stopped
+    ports:
+      - "8090"
+    environment:
+      - SEARCH_PORT=8090
+      - PRODUCT_CATALOG_ADDR
+      - OTEL_PYTHON_LOG_CORRELATION=true
+      - OTEL_EXPORTER_OTLP_ENDPOINT
+      - OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE
+      - OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION
+      - OTEL_RESOURCE_ATTRIBUTES=${OTEL_RESOURCE_ATTRIBUTES},service.criticality=medium
+      - OTEL_SERVICE_NAME=search
+      - OTEL_PYTHON_SDK_INTERNAL_METRICS_ENABLED=true
+      - PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
+    healthcheck:
+      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8090/healthz || exit 1"]
+      start_period: 10s
+      interval: 5s
+      timeout: 5s
+      retries: 20
+    depends_on:
+      product-catalog:
+        condition: service_started
+      otel-collector:
+        condition: service_started
+    logging:
+      driver: "json-file"
+      options:
+        max-size: "5m"
+        max-file: "2"
