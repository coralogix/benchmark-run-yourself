+# Benchmark: stand-in LLM gateway (see gateway.py). Stdlib only.
+FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6
+
+ENV PYTHONDONTWRITEBYTECODE=1 \
+    PYTHONUNBUFFERED=1
+WORKDIR /app
+COPY src/llm-gateway/gateway.py .
+
+ARG LLM_GATEWAY_PORT=8020
+EXPOSE ${LLM_GATEWAY_PORT}
+
+CMD ["python", "gateway.py"]
