+# Benchmark: the shop's AI assistant (agent) backed by a stand-in LLM
+# gateway (src/llm-gateway), for the AI cost scenario. Use it instead of
+# compose.agent.yaml, which would also add mcp and chatbot and patch
+# frontend-proxy and load-generator. agents/ops.sh dc includes it.
+#
+# No MCP (built-in shop tools), no VCR replay, no API key: the gateway
+# answers in 20 to 50 ms and reports token usage at about 4 characters per token.
+
+services:
+  llm-gateway:
+    image: harness-llm-gateway:1
+    pull_policy: build
+    container_name: llm-gateway
+    build:
+      context: ./
+      dockerfile: src/llm-gateway/Dockerfile
+    deploy:
+      resources:
+        limits:
+          memory: 64M
+    restart: unless-stopped
+    environment:
+      - LLM_GATEWAY_PORT=8020
+      - LLM_GATEWAY_MIN_MS=20
+      - LLM_GATEWAY_MAX_MS=50
+      # Share of comparison replies wrapped in prose when the prompt doesn't
+      # say "JSON only" (see gateway.py). 0.25 gives about 10 affected
+      # requests in a 20-minute window at 25% compare share (AGENT_COMPARE_SHARE).
+      - LLM_GATEWAY_FREEFORM_RATE=${LLM_GATEWAY_FREEFORM_RATE:-0.25}
+      - LLM_GATEWAY_FOLLOWUP_FREEFORM_RATE=${LLM_GATEWAY_FOLLOWUP_FREEFORM_RATE:-0.15}
+    logging:
+      driver: "json-file"
+      options:
+        max-size: "5m"
+        max-file: "2"
+
+  agent:
+    image: harness-agent:1
+    pull_policy: build
+    container_name: agent
+    build:
+      context: ./
+      dockerfile: ${AGENT_DOCKERFILE}
+    deploy:
+      resources:
+        limits:
+          memory: 500M
+    restart: unless-stopped
+    ports:
+      - "${AGENT_PORT}"
+    environment:
+      - TRACELOOP_BASE_URL
+      - GRAPH_RECURSION_LIMIT
+      - MCP_ENABLED=False
+      - AGENT_ENDPOINT
+      - AGENT_PORT
+      - LLM_BASE_URL=http://llm-gateway:8020/v1
+      - LLM_MODEL=gpt-4o-mini
+      - LLM_TLS_VERIFY=False
+      - USE_VCR=False
+      - API_KEY=
+      - APPLICATION_ENDPOINT
+      - OTEL_EXPORTER_OTLP_INSECURE=true
+      - OTEL_RESOURCE_ATTRIBUTES=${OTEL_RESOURCE_ATTRIBUTES},service.criticality=low
+      - OTEL_SERVICE_NAME=agent
+      - FLAGD_HOST
+      - FLAGD_PORT
+      - OTEL_PYTHON_SDK_INTERNAL_METRICS_ENABLED=true
+    depends_on:
+      otel-collector:
+        condition: service_started
+      llm-gateway:
+        condition: service_started
+    logging:
+      driver: "json-file"
+      options:
+        max-size: "5m"
+        max-file: "2"
