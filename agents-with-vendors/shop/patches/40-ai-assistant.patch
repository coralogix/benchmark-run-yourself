--- /dev/null
+++ b/src/llm-gateway/gateway.py
@@ -0,0 +1,181 @@
+#!/usr/bin/python
+# Benchmark: a stand-in for a hosted LLM. OpenAI-compatible /v1/chat/completions, fast
+# (20 to 50 ms) and free, with `usage` at about 4 characters per token.
+# It plays the model's part for the shop assistant:
+# - Tool-using chat (the agent's /prompt): ask for one shop tool, then answer.
+# - Product comparisons (the agent's /compare): reply with the comparison
+#   object. When the request doesn't spell out "JSON only", the reply is
+#   sometimes wrapped in prose instead
+#   (FREEFORM_RATE). After a "reply with only the JSON object" follow-up it
+#   complies, except at FOLLOWUP_FREEFORM_RATE.
+# Stdlib only. No OpenTelemetry of its own: it stands for an external API.
+
+import json
+import math
+import os
+import random
+import re
+import time
+import uuid
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+PORT = int(os.getenv("LLM_GATEWAY_PORT", "8020"))
+MIN_MS = float(os.getenv("LLM_GATEWAY_MIN_MS", "20"))
+MAX_MS = float(os.getenv("LLM_GATEWAY_MAX_MS", "50"))
+FREEFORM_RATE = float(os.getenv("LLM_GATEWAY_FREEFORM_RATE", "0.10"))
+FOLLOWUP_FREEFORM_RATE = float(os.getenv("LLM_GATEWAY_FOLLOWUP_FREEFORM_RATE", "0.15"))
+JSON_ONLY_RE = re.compile(r"only (with )?(a|the) JSON object", re.I)
+
+
+def tokens(text):
+    return max(1, math.ceil(len(text) / 4))
+
+
+def text_of(message):
+    c = message.get("content") or ""
+    if isinstance(c, list):  # content parts
+        c = " ".join(p.get("text", "") for p in c if isinstance(p, dict))
+    return c
+
+
+def prompt_tokens(body):
+    n = 0
+    for m in body.get("messages", []):
+        n += 4 + tokens(text_of(m))  # per-message overhead, like tiktoken's
+        for tc in m.get("tool_calls") or []:
+            n += tokens(json.dumps(tc))
+    if body.get("tools"):
+        n += tokens(json.dumps(body["tools"]))
+    return n + 3
+
+
+def comparison_object(messages):
+    """Build the comparison from the products listed in the user message."""
+    products = []
+    for m in messages:
+        if m.get("role") != "user":
+            continue
+        t = text_of(m)
+        i = t.find("[")
+        if i >= 0:
+            try:
+                products = json.loads(t[i:t.rindex("]") + 1])
+                break
+            except ValueError:
+                pass
+    rows = []
+    for p in products[:8]:
+        rows.append({
+            "id": p.get("id"),
+            "name": p.get("name"),
+            "price_usd": p.get("price_usd"),
+            "best_for": random.choice(["beginners", "travel", "deep-sky viewing", "families", "astrophotography"]),
+            "pros": random.sample(["lightweight", "easy setup", "sharp optics", "good value", "smartphone app", "sturdy mount"], 2),
+            "cons": random.sample(["small aperture", "manual tracking", "heavy", "pricier", "needs accessories"], 1),
+        })
+    pick = min(rows, key=lambda r: r.get("price_usd") or 0)["name"] if rows else None
+    return {"products": rows, "recommendation": pick,
+            "summary": f"Compared {len(rows)} products; {pick} is the best value for most shoppers." if rows else "No products to compare."}
+
+
+def comparison_reply(messages):
+    obj = json.dumps(comparison_object(messages), indent=2)
+    followup = messages and messages[-1].get("role") == "user" and JSON_ONLY_RE.search(text_of(messages[-1]))
+    strict = any(m.get("role") == "system" and JSON_ONLY_RE.search(text_of(m)) for m in messages)
+    if followup:
+        freeform = random.random() < FOLLOWUP_FREEFORM_RATE
+    elif strict:
+        freeform = False
+    else:
+        freeform = random.random() < FREEFORM_RATE
+    if not freeform:
+        return obj
+    return ("Great question! Here's a side-by-side look at these products to help you choose:\n\n"
+            f"```json\n{obj}\n```\n\nLet me know if you'd like more detail on any of them!")
+
+
+def tool_call_for(prompt):
+    p = prompt.lower()
+    if "currenc" in p:
+        return "get_supported_currencies", {}
+    if "promotion" in p or "ads" in p or "deal" in p:
+        cat = "binoculars" if "binocular" in p else "telescopes"
+        return "get_ads", {"category": cat}
+    if "product" in p or "store" in p or "catalog" in p:
+        return "list_products", {}
+    return None, None
+
+
+def chat_reply(body):
+    messages = body.get("messages", [])
+    system = " ".join(text_of(m) for m in messages if m.get("role") == "system")
+    if "product comparison" in system.lower():
+        return {"role": "assistant", "content": comparison_reply(messages)}, "stop"
+    last = messages[-1] if messages else {}
+    if last.get("role") == "tool":
+        result = text_of(last)
+        return {"role": "assistant",
+                "content": f"Here's what I found: {result[:600]}" + ("…" if len(result) > 600 else "")}, "stop"
+    user = next((text_of(m) for m in reversed(messages) if m.get("role") == "user"), "")
+    name, args = tool_call_for(user) if body.get("tools") else (None, None)
+    if name:
+        return {"role": "assistant", "content": None, "tool_calls": [{
+            "id": "call_" + uuid.uuid4().hex[:24], "type": "function",
+            "function": {"name": name, "arguments": json.dumps(args)}}]}, "tool_calls"
+    return {"role": "assistant", "content": "I can help you browse products, check promotions and currencies."}, "stop"
+
+
+def completion(body):
+    message, finish = chat_reply(body)
+    pt = prompt_tokens(body)
+    out = message.get("content") or json.dumps(message.get("tool_calls"))
+    ct = tokens(out)
+    return {
+        "id": "chatcmpl-" + uuid.uuid4().hex[:29],
+        "object": "chat.completion",
+        "created": int(time.time()),
+        "model": body.get("model") or "gpt-4o-mini",
+        "system_fingerprint": "fp_" + uuid.uuid4().hex[:10],
+        "choices": [{"index": 0, "message": message, "logprobs": None, "finish_reason": finish}],
+        "usage": {"prompt_tokens": pt, "completion_tokens": ct, "total_tokens": pt + ct,
+                  "prompt_tokens_details": {"cached_tokens": 0, "audio_tokens": 0},
+                  "completion_tokens_details": {"reasoning_tokens": 0, "audio_tokens": 0,
+                                                "accepted_prediction_tokens": 0, "rejected_prediction_tokens": 0}},
+    }
+
+
+class Handler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def _send(self, code, obj):
+        data = json.dumps(obj).encode()
+        self.send_response(code)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(data)))
+        self.end_headers()
+        self.wfile.write(data)
+
+    def do_GET(self):
+        if self.path.rstrip("/").endswith("/models"):
+            return self._send(200, {"object": "list", "data": [{"id": "gpt-4o-mini", "object": "model", "owned_by": "openai"}]})
+        if self.path == "/health":
+            return self._send(200, {"status": "ok"})
+        self._send(404, {"error": {"message": "not found"}})
+
+    def do_POST(self):
+        n = int(self.headers.get("Content-Length") or 0)
+        try:
+            body = json.loads(self.rfile.read(n) or b"{}")
+        except ValueError:
+            return self._send(400, {"error": {"message": "invalid JSON body", "type": "invalid_request_error"}})
+        if not self.path.rstrip("/").endswith("/chat/completions"):
+            return self._send(404, {"error": {"message": "not found"}})
+        time.sleep(random.uniform(MIN_MS, MAX_MS) / 1000)
+        self._send(200, completion(body))
+
+    def log_message(self, *args):
+        pass
+
+
+if __name__ == "__main__":
+    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
