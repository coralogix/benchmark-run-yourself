+#!/usr/bin/python
+# Benchmark: the assistant's "compare products" feature.
+# The model is asked for a structured comparison, which the shop renders as
+# a table, so the reply must parse as JSON. A reply that doesn't parse is
+# sent back with a short follow-up, up to MAX_FOLLOWUPS times; after that
+# the raw text is returned as the summary, so the shopper always gets an answer.
+#
+# The prompt template is chosen per request from a small config file
+# (PROMPT_VERSION_FILE, "v1" or "v2"; v1 if missing), so it can be changed
+# without a restart.
+
+import json
+import logging
+import os
+from typing import Any, Dict, List
+
+from langchain_core.messages import AIMessage, HumanMessage, SystemMessage
+from src.agents.llm import ChatLLM
+from src.agents.tools import list_products
+from traceloop.sdk.decorators import task, workflow
+
+logger = logging.getLogger(__name__)
+
+PROMPT_VERSION_FILE = os.getenv("COMPARE_PROMPT_VERSION_FILE", "/tmp/compare_prompt_version")
+MAX_FOLLOWUPS = int(os.getenv("COMPARE_MAX_FOLLOWUPS", "3"))
+
+SCHEMA = (
+    '{"products": [{"id", "name", "price_usd", "best_for", "pros", "cons"}], '
+    '"recommendation": "<product name>", "summary": "<one sentence>"}'
+)
+
+TEMPLATES = {
+    "v1": (
+        "You are the Astronomy Shop's product comparison assistant. Compare the "
+        "products the shopper is looking at. Respond only with a JSON object in "
+        f"this shape: {SCHEMA}. Do not add any other text."
+    ),
+    # v2: rewritten for a friendlier, more personal tone.
+    "v2": (
+        "You are the Astronomy Shop's product comparison assistant: friendly, "
+        "enthusiastic and knowledgeable about astronomy. Help the shopper choose "
+        "between the products they're looking at, highlighting what each one is "
+        f"best for. Use this structure: {SCHEMA}."
+    ),
+}
+
+FOLLOWUP = "Your previous reply could not be read. Reply again with only the JSON object, no other text."
+
+
+def prompt_version() -> str:
+    try:
+        with open(PROMPT_VERSION_FILE) as f:
+            v = f.read().strip()
+        return v if v in TEMPLATES else "v1"
+    except OSError:
+        return "v1"
+
+
+def product_rows(products: List[Dict[str, Any]], category: str) -> List[Dict[str, Any]]:
+    rows = []
+    for p in products:
+        if category and category not in (p.get("categories") or []):
+            continue
+        price = p.get("priceUsd") or {}
+        rows.append({
+            "id": p.get("id"),
+            "name": p.get("name"),
+            "description": p.get("description"),
+            "price_usd": round(float(price.get("units", 0)) + float(price.get("nanos", 0)) / 1e9, 2),
+        })
+    return rows
+
+
+def parse(content: str) -> Dict[str, Any] | None:
+    try:
+        obj = json.loads(content)
+    except (TypeError, ValueError):
+        return None
+    return obj if isinstance(obj, dict) and "products" in obj else None
+
+
+@task(name="generate_comparison")
+async def generate(model, messages) -> str:
+    reply = await model.ainvoke(messages)
+    return reply.content if isinstance(reply.content, str) else str(reply.content)
+
+
+@workflow(name="product_comparison")
+async def compare_products(category: str, model=None, products=None) -> Dict[str, Any]:
+    model = model or ChatLLM()
+    if products is None:
+        products = await list_products()
+        if isinstance(products, dict):
+            products = products.get("products", [])
+        if not isinstance(products, list):
+            products = []
+    rows = product_rows(products, category)
+    messages = [
+        SystemMessage(content=TEMPLATES[prompt_version()]),
+        HumanMessage(content=f"Category: {category}. Products: {json.dumps(rows)}"),
+    ]
+    content = await generate(model, messages)
+    result = parse(content)
+    followups = 0
+    while result is None and followups < MAX_FOLLOWUPS:
+        followups += 1
+        logger.debug("comparison reply not parseable, follow-up %d", followups)
+        messages += [AIMessage(content=content), HumanMessage(content=FOLLOWUP)]
+        content = await generate(model, messages)
+        result = parse(content)
+    if result is None:
+        result = {"products": [], "recommendation": None, "summary": content}
+    return {"category": category, "comparison": result}
