@@ -28,6 +32,42 @@ const val groupID = "fraud-detection"
 
 private val logger: Logger = LogManager.getLogger(groupID)
 
+private const val REVIEW_FILE = "/tmp/order-review.conf"
+private var reviewAsync = false
+private var reviewPct = 0
+private var lastReviewCheck = 0L
+private val reviewers = ArrayList<ExecutorService>()
+
+private fun refreshReviewConfig() {
+    val now = System.currentTimeMillis()
+    if (now - lastReviewCheck < 5000) return
+    lastReviewCheck = now
+    // "async <percent of orders sampled>" or "sync" (default).
+    val parts = try { File(REVIEW_FILE).readText().trim().split(Regex("\\s+")) } catch (e: Exception) { listOf("sync") }
+    if (parts[0] == "async") {
+        reviewAsync = true
+        reviewPct = parts.getOrNull(1)?.toIntOrNull() ?: 25
+    } else if (reviewAsync || reviewers.isNotEmpty()) {
+        reviewAsync = false; reviewPct = 0
+        reviewers.forEach { it.shutdown() }
+        reviewers.clear()
+    }
+}
+
+private fun reviewScore(order: OrderResult): Long {
+    var score = 0L
+    for (item in order.itemsList) score += item.item.quantity * item.cost.units
+    return score
+}
+
+// Sampled orders get a second-opinion score off the consumer thread.
+private fun sampleForReview(order: OrderResult) {
+    if (!reviewAsync || ThreadLocalRandom.current().nextInt(100) >= reviewPct) return
+    val reviewer = Executors.newFixedThreadPool(1)
+    reviewers.add(reviewer)
+    reviewer.execute { reviewScore(order) }
+}
+
