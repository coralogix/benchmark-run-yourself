# Copy to .env and fill in. Never commit .env. agents/ops.sh passes this file to Docker Compose
# for the collector; the harness reads only its own settings from it and
# never exports platform keys to the agents.

# --- Collector exporters (otel-demo/src/otel-collector/otelcol-config-extras.yml)
# Coralogix domain for your region, for example eu2.coralogix.com.
CORALOGIX_DOMAIN=
# Coralogix Send-Your-Data API key.
CORALOGIX_PRIVATE_KEY=
# Datadog API key.
DATADOG_API_KEY=
# Datadog site of your account, for example datadoghq.eu; the Datadog agent's prompt names it too.
DATADOG_SITE=
# Grafana Cloud OTLP gateway, https://otlp-gateway-<region>.grafana.net/otlp.
GRAFANA_OTLP_ENDPOINT=
# Grafana Cloud stack instance ID (the OTLP basic-auth user name).
GRAFANA_INSTANCE_ID=
# Grafana Cloud access policy token with metrics, logs and traces write scopes.
GRAFANA_API_TOKEN=
# New Relic OTLP endpoint for your data center (https://otlp.nr-data.net or https://otlp.eu01.nr-data.net).
NEWRELIC_OTLP_ENDPOINT=
# New Relic ingest license key.
NEWRELIC_LICENSE_KEY=
# Dynatrace OTLP endpoint, https://<environment-id>.live.dynatrace.com/api/v2/otlp.
DYNATRACE_OTLP_ENDPOINT=
# Dynatrace API token with the openTelemetryTrace.ingest, metrics.ingest and logs.ingest scopes.
DYNATRACE_API_TOKEN=

# --- Agent CLIs (agents/lib.sh, agents/preflight.sh)
# New Relic account ID, passed to the agents and to preflight queries.
NEWRELIC_ACCOUNT_ID=
# cx profile pointing at the benchmark's Coralogix account (default competitor-comparison).
CX_PROFILE=
# Datadog site named in the Datadog agent's prompt, if it differs from DATADOG_SITE.
DD_SITE=
# dtctl context with a read-only token for the Dynatrace environment (default competitor-comparison-readonly).
DTCTL_CONTEXT=
# gcx context for the Grafana Cloud stack (default competitor-comparison).
GCX_CONTEXT=
# newrelic CLI profile (default competitor-comparison).
NR_PROFILE=
# Optional: file name of dtctl's token-refresh lock in CLAUDE_SANDBOX_TMP, admitted to the Dynatrace sandbox.
DTCTL_LOCK_FILE=

# --- Harness
# Directory for the agents' empty work dirs and settings (default ~/vendor-agents).
AGENT_HOME=
# Directory for transcripts and sessions.csv (default results/runs; make score reads results/runs).
RESULTS_DIR=
# Model for every agent (default claude-opus-5-5).
AGENT_MODEL=
# Reasoning effort for every agent (default high).
AGENT_EFFORT=
# Claude Code's shared sandbox temp directory (default /tmp/claude-<uid>).
CLAUDE_SANDBOX_TMP=
# Space-separated names of non-shop containers to stop before each scenario.
STOP_CONTAINERS=

# --- Budget and delivery checks (agents/budget-window.py, agents/delivery-check.py)
# Demo Prometheus URL (default http://localhost:9090).
PROMETHEUS_URL=
# Regex of container names to leave out of the series counts.
NON_SHOP_CONTAINERS=
# Path of the budget inputs (default config/budget.json).
BUDGET_CONFIG=

# --- Scoring (scoring/review.sh)
# Model for the reviewing agent (default AGENT_MODEL, else claude-opus-5-5).
REVIEW_MODEL=
# Reasoning effort for the reviewing agent (default high).
REVIEW_EFFORT=
# Reviews run at once (default 2).
REVIEW_MAXPAR=
# Reference measurements the reviewer marks against (default results/ground-truth.yaml).
GROUND_TRUTH=
