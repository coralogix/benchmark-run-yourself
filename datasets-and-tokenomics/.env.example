# Copy to .env and fill in. Never commit .env. The Makefile exports every value to the scripts.

# --- Coralogix account
# API key with DataPrime query, dataset management and Background Queries permissions. The agents use it read-only.
CX_API_KEY=
# Region for the cx CLI, for example eu1 (the published study ran in eu1).
CX_REGION=
# Coralogix domain of that region, for example eu1.coralogix.com. See https://coralogix.com/docs/integrations/coralogix-endpoints/
CX_DOMAIN=
# Send-Your-Data API key, used by the generator to send logs and spans.
CX_SEND_DATA_KEY=
# Ingress base URL of that region, https://ingress.<CX_DOMAIN>
CX_INGRESS_URL=

# --- Replayed week
# First hour of the replayed week, UTC, on the hour, for example 2026-12-01T00:00:00Z. The generator sends each hour in
# real time from here, the datasets cover the 7 days that follow, and every question names this window.
RUN_START=

# --- Model (any OpenAI-compatible endpoint serving GLM 5.3)
# Model ID as your endpoint names it.
MODEL_ID=glm-5.3
# Base URL of the endpoint, ending in /v1.
MODEL_BASE_URL=
# Path to a file holding the endpoint's API key.
MODEL_KEY_FILE=

# --- Run size
# Repetitions of every question per arm (published: 10).
REPS=10
# Questions run at once; each runs its three arms together, so the endpoint sees up to 3x this many agents.
PARALLEL=6
