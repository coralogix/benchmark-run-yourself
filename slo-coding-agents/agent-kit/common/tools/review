#!/usr/bin/env python3
"""review: ask an independent reviewer to assess a backlog item you have implemented.

Usage:
  tools/review FEAT-017 "Added DELETE /api/carts/<id>/items/<sku> in edge-api and cart; tests in tests/test_cart.py"
  tools/review REL-2 "Release the pool connection on the slot_full path"
  tools/review FEAT-017,FEAT-018 "Cart item delete and quantity endpoints"   (several items in one review)

The reviewer works on a frozen snapshot of both repositories (your current working tree, committed or not)
and scores the change 0-10 on functionality, correctness, code quality, resilience, error handling, test
coverage, operability and regression safety, plus an overall 0-100 production-readiness score, with
must-fix and should-fix issues. A review typically takes 2-6 minutes.

Afterwards, decide whether it is good enough and record it with tools/ship.
"""
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

WS = Path(__file__).resolve().parent.parent


def url():
    u = os.environ.get("LARDER_REVIEW_URL")
    if not u:
        for ln in (WS / ".larder" / "agent.env").read_text().splitlines():
            if ln.startswith("LARDER_REVIEW_URL="):
                u = ln.split("=", 1)[1].strip()
    if not u:
        sys.exit("review: review service not configured")
    return u.rstrip("/")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    item, note = sys.argv[1], " ".join(sys.argv[2:])
    req = urllib.request.Request(url() + "/review", data=json.dumps({"item": item, "note": note}).encode(),
                                 headers={"Content-Type": "application/json"}, method="POST")
    print(f"Review of {item} requested; waiting for the reviewer...", flush=True)
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            res = json.loads(r.read())
    except urllib.error.HTTPError as e:
        res = json.loads(e.read() or b"{}")
        print(f"review failed: {res.get('detail') or res.get('error') or e}")
        sys.exit(1)
    print(f"\nReview #{res['review_id']} of {res['item']}: overall {res.get('overall')}/100\n")
    for k, v in (res.get("scores") or {}).items():
        print(f"  {k:18} {v:4.1f}/10")
    for title, key in (("Must fix", "must_fix"), ("Should fix", "should_fix")):
        items = res.get(key) or []
        print(f"\n{title} ({len(items)}):")
        for i in items:
            print(f"  - {i}")
    print(f"\nSummary: {res.get('summary', '')}")
    print(f"\nIf you are satisfied: tools/ship {res['item']} --accepted-score {res.get('overall')} --reason \"...\"")


if __name__ == "__main__":
    main()
