# Copy to .env and fill in. Never commit .env. Names and paths only; the Makefile exports every line.
# One comment line above each variable; keep values free of trailing spaces.

# --- AWS (the account that runs the trial instances)
# AWS CLI profile with EC2, IAM, SSM, S3 and EventBridge Scheduler permissions. Uncomment to use one; otherwise default credentials apply.
# AWS_PROFILE=
# One region for every trial and both buckets, for example eu-west-1.
AWS_REGION=
# S3 bucket for the Coralogix logs archive of every team.
LARDER_LOGS_BUCKET=
# S3 bucket for the Coralogix metrics archive of every team.
LARDER_METRICS_BUCKET=
# s3://<bucket>/<prefix> for the code bundle and trial results (can sit in the logs bucket).
LARDER_RESULTS_S3=

# --- Coralogix
# Coralogix region of your teams, for example eu1.
LARDER_CX_REGION=
# Path to your team list (default harness/config/batch_teams.json).
LARDER_BATCH_TEAMS=

# --- Model (your own OpenAI-compatible endpoint serving GLM 5.3 Flash, used by the agent and the reviewer)
# <provider>/<model> as named in your opencode.json, for example myprovider/glm-5.3-flash.
LARDER_MODEL=
# Endpoint base URL without /v1; the governor forwards to it and the preflight calls /v1/models.
LARDER_MODEL_BASE_URL=
# Path to a file with the endpoint's API key (default ~/.config/opencode/model-api-key).
LARDER_MODEL_KEY_FILE=
# Path to the opencode.json that names the provider (default ~/.config/opencode/opencode.json).
LARDER_OPENCODE_CONFIG=

# --- Batches (two batches of 10 pairs)
# Batch id for pairs 1 to 10 of the first batch, for example batch-a.
LARDER_BATCH_A=
# Batch id for the second batch.
LARDER_BATCH_B=
# UTC ISO start of the first batch's first wave, for example 2026-01-05T10:45:00Z.
LARDER_BATCH_A_START=
# UTC ISO start of the second batch's first wave, at least 600 minutes after the first.
LARDER_BATCH_B_START=

# --- Outputs
# Where the figure scripts write their JSON (default results/assets).
LARDER_ASSETS_DIR=
