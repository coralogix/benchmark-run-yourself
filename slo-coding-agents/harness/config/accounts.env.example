# Copy to harness/config/accounts.env (gitignored) and fill in.
# Values are cx CLI profile NAMES and API key IDs, never secrets.
#
# One Coralogix account per condition. The basic account must have no SLOs.

# Operator profiles: write access to dashboards, alerts, SLOs, and read access to API keys.
LARDER_BASIC_OPERATOR_PROFILE=larder-basic
LARDER_SLO_OPERATOR_PROFILE=larder-slo

# Read-only profiles handed to the evaluated agents. Create with: ./bench agent-key --condition <c>
LARDER_BASIC_AGENT_PROFILE=larder-basic-agent
LARDER_SLO_AGENT_PROFILE=larder-slo-agent

# ID of a key with the SendData preset in each account (value is fetched at start, never stored).
# Find it with: cx -p <operator profile> iam api-keys list
# Alternatively export LARDER_BASIC_INGEST_KEY / LARDER_SLO_INGEST_KEY in the operator shell.
LARDER_BASIC_INGEST_KEY_ID=
LARDER_SLO_INGEST_KEY_ID=

# Where per-run agent workspaces are created (outside this repo so agents cannot see the evaluator).
LARDER_WORKSPACE_ROOT=~/larder-workspaces
