@@ -0,0 +1,64 @@
+"""
+Customer self-registration (FEAT-075).
+
+    register(name, email, postcode) -> {"user_id"}
+
+Emails are unique case-insensitively. Postcodes must map to a delivery zone
+(asked of ops' slots service, the owner of the zone map).
+"""
+import datetime
+import re
+import threading
+
+from larder_common import dbx
+from larder_common.errors import BadRequest, Conflict, UpstreamError
+from larder_common.http import client
+from larder_common.log import get_logger
+from services.accounts import postcodes
+from services.accounts.models import User
+
+log = get_logger("accounts.registration")
+
+EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s.]+$")
+MAX_EMAIL_LEN = 254
+_LOCK = threading.Lock()
+
+
+def _zone_for(postcode):
+    res = client("slots").get("/internal/zones/lookup", params={"postcode": postcode})
+    if res.status == 404:
+        return None
+    if not res.ok:
+        raise UpstreamError("slots_unavailable")
+    return (res.body or {}).get("zone")
+
+
+def _next_user_id(d):
+    n = 0
+    for r in d.query("SELECT user_id FROM users WHERE user_id LIKE 'u-%'"):
+        try:
+            n = max(n, int(r["user_id"][2:]))
+        except ValueError:
+            continue
+    return "u-%04d" % (n + 1)
+
+
+def register(name, email, postcode):
+    name = (name or "").strip()
+    email = (email or "").strip()
+    if not name:
+        raise BadRequest("name_required")
+    if len(email) > MAX_EMAIL_LEN or not EMAIL_RE.match(email):
+        raise BadRequest("invalid_email")
+    pc = postcodes.normalise(postcode)
+    if not pc or not _zone_for(pc):
+        raise BadRequest("invalid_postcode")
+    d = dbx.db("accounts")
+    with _LOCK:
+        if d.query_one("SELECT user_id FROM users WHERE lower(email) = lower(?)", (email,)):
+            raise Conflict("email_taken")
+        user_id = _next_user_id(d)
+        User.create(user_id=user_id, name=name, email=email, postcode=pc,
+                    created=datetime.date.today().isoformat())
+    log.info("registered %s", user_id)
+    return {"user_id": user_id}
