+/**
+ * FEAT-061: restock - goods arrive. on_hand += qty. The read-modify-write is
+ * synchronous (no await between reading and writing the record), so concurrent
+ * restocks and reservations can't lose each other's updates.
+ */
+async function restock(sku, qty, ctx) {
+  if (typeof qty !== 'number' || !Number.isInteger(qty) || qty <= 0) {
+    throw new errors.BadRequest('qty must be a positive integer', { sku: sku });
+  }
+  var rec = await col().get(sku);
+  if (!rec) throw new errors.NotFound('unknown sku ' + sku, { sku: sku });
+  rec.on_hand = rec.on_hand + qty;
+  rec.updated_at = new Date().toISOString();
+  var out = view(rec);
+  await col().put(rec);
+  auditTrail.record('restock', { sku: sku, qty: qty, ref: ctx && ctx.ref });
+  telemetry.inc('reservations', { outcome: 'restocked' });
+  return out;
+}
