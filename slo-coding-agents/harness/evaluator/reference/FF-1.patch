# FF-1 reference fix. Repo: ops (apply inside the ops/ directory: git apply FF-1.patch)
diff --git a/services/inventory/stock.js b/services/inventory/stock.js
index 9f3c08e..4202a4c 100644
--- a/services/inventory/stock.js
+++ b/services/inventory/stock.js
@@ -122,13 +122,19 @@ async function reserve(sku, qty, ctx) {
     throw new errors.OutOfStock('unknown sku ' + sku, { sku: sku });
   }
 
+  // REL-4: check and take the units in one synchronous step. Awaiting anything
+  // between the availability check and the write let concurrent reservations
+  // read the same stale `available` and oversell. FIN-77's audit line is
+  // written right after the movement is applied.
   var available = rec.on_hand - rec.reserved;
   if (available < qty) {
     telemetry.inc('reservations', { outcome: 'out_of_stock' });
     throw new errors.OutOfStock('insufficient stock for ' + sku, { sku: sku, available: available, requested: qty });
   }
+  rec.reserved = rec.reserved + qty;
+  rec.updated_at = new Date().toISOString();
+  await col().put(rec);
 
-  // FIN-77: every movement is audited before it is applied
   await auditTrail.record('reserve', {
     sku: sku,
     qty: qty,
@@ -136,10 +142,6 @@ async function reserve(sku, qty, ctx) {
     available_before: available
   });
 
-  rec.reserved = rec.reserved + qty;
-  rec.updated_at = new Date().toISOString();
-  await col().put(rec);
-
   globals.counters.reservations++;
   telemetry.inc('reservations', { outcome: 'reserved' });
   return { sku: sku, qty: qty, available: available - qty };
