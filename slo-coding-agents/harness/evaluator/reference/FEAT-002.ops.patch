+/**
+ * FEAT-002 cancelOrder(ref) -> { status, body }
+ *   200 { order_ref, status: "cancelled", refund_pence }  (also for a repeat)
+ *   409 already_dispatched | not_cancellable, 404 order_not_found, 502 refund_failed
+ * Calls for the same ref are serialised so a double click refunds once.
+ */
+var cancelChains = {};
+
+function cancelOrder(ref) {
+  ref = String(ref);
+  var prev = cancelChains[ref] || Promise.resolve();
+  var next = prev.then(function () { return doCancel(ref); });
+  var tail = next.catch(function () {});
+  cancelChains[ref] = tail;
+  tail.then(function () { if (cancelChains[ref] === tail) delete cancelChains[ref]; });
+  return next;
+}
+
+function cancelledBody(o) {
+  return { order_ref: o.order_ref, status: STATUS.CANCELLED, refund_pence: o.refund_pence };
+}
+
+async function doCancel(ref) {
+  var list = await store.findAllByRef(ref);
+  if (!list.length) return { status: 404, body: { error: 'order_not_found' } };
+  var o = _.find(list, { status: STATUS.CANCELLED }) || _.find(list, { status: STATUS.DISPATCHED }) ||
+    _.find(list, { status: STATUS.CONFIRMED }) || list[0];
+  if (o.status === STATUS.CANCELLED) return { status: 200, body: cancelledBody(o) };
+  if (o.status === STATUS.DISPATCHED) return { status: 409, body: { error: 'already_dispatched' } };
+  if (o.status !== STATUS.CONFIRMED) return { status: 409, body: { error: 'not_cancellable' } };
+
+  var r = await peers.refund({ order_ref: o.order_ref, charge_id: o.charge_id, amount_pence: o.total_pence });
+  if (r.status !== 201) return { status: 502, body: { error: 'refund_failed' } };
+
+  await peers.releaseReservations((o.items || []).map(function (l) { return { sku: l.sku, qty: l.qty }; }), ref);
+  if (o.hold_id) await peers.releaseHold(o.hold_id, 'cancelled');
+
+  o.status = STATUS.CANCELLED;
+  o.cancelled_at = new Date().toISOString();
+  o.refund_pence = o.total_pence;
+  o.refund_id = r.body && r.body.refund_id;
+  await store.save(o);
+
+  await peers.ledgerEntry({
+    order_ref: ref, kind: 'refund', amount_pence: o.total_pence, charge_id: o.charge_id,
+    user_id: o.user_id, meta: { source: 'orders', refund_id: o.refund_id }
+  });
+  await busClient.publish('order.cancelled', ref, {
+    order_ref: ref, user_id: o.user_id, email: o.email, status: STATUS.CANCELLED,
+    refund_pence: o.refund_pence, items: o.items, coupon: o.coupon, cancelled_at: o.cancelled_at
+  });
+  logger.info('orders: cancelled', { order_ref: ref, refund_pence: o.refund_pence });
+  return { status: 200, body: cancelledBody(o) };
+}
+
 module.exports = {
