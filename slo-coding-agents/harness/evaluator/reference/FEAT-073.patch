+// FEAT-073: PATCH /internal/slots/:slot_id { capacity } (never below current bookings)
+router.patch('/slots/:slot_id', asyncRoute(async function (req, res) {
+  var cap = req.body && req.body.capacity;
+  if (typeof cap !== 'number' || !Number.isInteger(cap) || cap < 0) {
+    return res.status(400).json({ error: 'invalid_capacity' });
+  }
+  var col = db.collection('slots');
+  var slot = await col.get(req.params.slot_id);
+  if (!slot) return res.status(404).json({ error: 'slot_not_found' });
+  if (cap < slot.booked) return res.status(409).json({ error: 'below_booked', booked: slot.booked });
+  slot.capacity = cap;
+  await col.put(slot);
+  res.json(slots.slotView(slot));
+}));
