diff --git a/services/promotions/one_use.py b/services/promotions/one_use.py
new file mode 100644
index 0000000..5b4a758
--- /dev/null
+++ b/services/promotions/one_use.py
@@ -0,0 +1,59 @@
+"""
+FEAT-012: one-use-per-customer coupons.
+
+A redemption row is a claim on (code, user). Checkout claims the code before it
+asks ops for the order (so two simultaneous checkouts can't both get the
+discount), confirms the claim when the order is confirmed and drops it if the
+order fails. Applying a code that the customer has a confirmed redemption for
+is refused with coupon_already_used.
+"""
+import datetime
+import threading
+
+from larder_common import dbx
+from larder_common.errors import CouponError
+
+ONE_USE_CODES = {"WELCOME10", "STUDENT20"}
+_LOCK = threading.Lock()
+
+
+def _db():
+    return dbx.db("promotions")
+
+
+def _now():
+    return datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def check_unused(code, user_id):
+    if code not in ONE_USE_CODES or not user_id:
+        return
+    n = _db().scalar("SELECT COUNT(*) FROM redemptions WHERE code = ? AND user_id = ? AND order_ref NOT LIKE 'claim:%'",
+                     (code, user_id), 0)
+    if n:
+        raise CouponError("coupon_already_used")
+
+
+def claim(code, user_id, order_ref):
+    """True if this checkout may use the code. Claims are 'claim:<ref>' until confirmed."""
+    if code not in ONE_USE_CODES or not user_id:
+        return True
+    with _LOCK:
+        n = _db().scalar("SELECT COUNT(*) FROM redemptions WHERE code = ? AND user_id = ?", (code, user_id), 0)
+        if n:
+            return False
+        _db().execute("INSERT INTO redemptions (code, user_id, order_ref, created_at) VALUES (?, ?, ?, ?)",
+                      (code, user_id, "claim:" + order_ref, _now()))
+        return True
+
+
+def confirm(code, user_id, order_ref):
+    with _LOCK:
+        _db().execute("UPDATE redemptions SET order_ref = ? WHERE code = ? AND user_id = ? AND order_ref = ?",
+                      (order_ref, code, user_id, "claim:" + order_ref))
+
+
+def release(code, user_id, order_ref):
+    with _LOCK:
+        _db().execute("DELETE FROM redemptions WHERE code = ? AND user_id = ? AND order_ref IN (?, ?)",
+                      (code, user_id, order_ref, "claim:" + order_ref))
diff --git a/services/promotions/routes.py b/services/promotions/routes.py
index 507a475..c479860 100644
--- a/services/promotions/routes.py
+++ b/services/promotions/routes.py
@@ -14,7 +14,7 @@ from flask import Blueprint
 from larder_common.errors import NotFound
 from larder_common.utils import safe_int
 from larder_common.web import body, ok
-from services.promotions import coupons
+from services.promotions import coupons, one_use
 
 bp = Blueprint("promotions", __name__)
 
@@ -28,9 +28,34 @@ def list_coupons():
 def validate():
     data = body()
     coupon = coupons.check_code(data.get("code"), safe_int(data.get("subtotal_pence"), 0))
+    one_use.check_unused(coupon.code, data.get("user_id"))
     return ok(coupon.as_payload())
 
 
+@bp.route("/internal/coupons/<code>/claim", methods=["POST"])
+def claim(code):
+    data = body()
+    code = coupons.normalise_code(code)
+    if not one_use.claim(code, data.get("user_id"), data.get("order_ref") or ""):
+        from larder_common.errors import CouponError
+
+        raise CouponError("coupon_already_used")
+    return ok({"ok": True})
+
+
+@bp.route("/internal/coupons/<code>/claim", methods=["PUT", "DELETE"])
+def settle(code):
+    from flask import request
+
+    data = body()
+    code = coupons.normalise_code(code)
+    if request.method == "PUT":
+        one_use.confirm(code, data.get("user_id"), data.get("order_ref") or "")
+    else:
+        one_use.release(code, data.get("user_id"), data.get("order_ref") or "")
+    return ok({"ok": True})
+
+
