 bp = Blueprint("checkout", __name__)
 
+# FEAT-038: Idempotency-Key -> (status, body) of the first completed checkout.
+# One lock per key, so concurrent retries wait for the first attempt instead of
+# creating a second order. Server errors (5xx) are not remembered, so a retry
+# after a transient failure runs again.
+_IDEM_RESULTS = {}
+_IDEM_LOCKS = {}
+_IDEM_GUARD = threading.Lock()
+IDEM_MAX_KEYS = 50000
+
+
+def _key_lock(key):
+    with _IDEM_GUARD:
+        lock = _IDEM_LOCKS.get(key)
+        if lock is None:
+            if len(_IDEM_LOCKS) > IDEM_MAX_KEYS:
+                _IDEM_LOCKS.clear()
+                _IDEM_RESULTS.clear()
+            lock = _IDEM_LOCKS[key] = threading.Lock()
+        return lock
+
+
+def _replay(stored):
+    status, payload = stored
+    resp = jsonify(payload)
+    resp.status_code = status
+    return resp
+
+
+def _checkout(data):
+    if not data.get("cart_id"):
+        raise BadRequest("cart_id_required")
+    return upstreams.checkout(data.get("cart_id"), data.get("hold_id"), data.get("payment_token"))
+
 
