+@bp.route("/internal/coupons/eligible")
+def eligible():
+    # FEAT-086: unexpired visible coupons whose minimum spend a basket of subtotal_pence meets
+    subtotal = safe_int(request.args.get("subtotal_pence"), 0)
+    out = []
+    for c in coupons.list_visible():
+        if coupons.is_expired(c):
+            continue
+        if int(round((c.min_spend or 0) * 100)) > subtotal:
+            continue
+        out.append(c.code)
+    return ok({"coupons": out})
