     return sorted(set(node.get("$", [])))[:MAX_SUGGESTIONS]
+
+
+# FEAT-030: suggestions for the search box. Names whose words start with the
+# prefix (case-insensitive), distinct, alphabetical, at most 8. Built once from
+# the index (products don't change while we run).
+MIN_PREFIX = 2
+_NAMES = {"list": None}
+
+
+def _names():
+    if _NAMES["list"] is None:
+        names = sorted({e.name for e in index.index_snapshot()}, key=lambda n: (n.casefold(), n))
+        _NAMES["list"] = [(n, [w.casefold() for w in n.split()]) for n in names]
+    return _NAMES["list"]
+
+
+def suggest_words(prefix):
+    p = (prefix or "").strip().casefold()
+    if len(p) < MIN_PREFIX:
+        return []
+    out = []
+    for name, words in _names():
+        if any(w.startswith(p) for w in words):
+            out.append(name)
+            if len(out) == MAX_SUGGESTIONS:
+                break
+    return out
