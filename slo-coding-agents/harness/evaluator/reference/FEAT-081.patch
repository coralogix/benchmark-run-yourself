+"""gzip for responses over 1 KB when the client accepts it (FEAT-081)."""
+import gzip
+
+from flask import request
+
+MIN_BYTES = 1024
+
+
+def _accepts_gzip():
+    for part in request.headers.get("Accept-Encoding", "").split(","):
+        bits = part.strip().split(";")
+        if bits[0].strip().lower() in ("gzip", "*"):
+            q = 1.0
+            for b in bits[1:]:
+                if b.strip().startswith("q="):
+                    try:
+                        q = float(b.strip()[2:])
+                    except ValueError:
+                        q = 0.0
+            if q > 0:
+                return True
+    return False
+
+
+def install(app):
+    @app.after_request
+    def _gzip(resp):
+        vary = resp.headers.get("Vary")
+        if "accept-encoding" not in (vary or "").lower():
+            resp.headers["Vary"] = (vary + ", " if vary else "") + "Accept-Encoding"
+        if resp.direct_passthrough or resp.status_code < 200 or resp.status_code in (204, 304):
+            return resp
+        if "Content-Encoding" in resp.headers or not _accepts_gzip():
+            return resp
+        data = resp.get_data()
+        if len(data) <= MIN_BYTES:
+            return resp
+        resp.set_data(gzip.compress(data, compresslevel=5))
+        resp.headers["Content-Encoding"] = "gzip"
+        resp.headers["Content-Length"] = str(len(resp.get_data()))
+        return resp
