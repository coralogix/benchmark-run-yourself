diff --git a/services/checkout/prescreen.py b/services/checkout/prescreen.py
new file mode 100644
index 0000000..8e0a5e1
--- /dev/null
+++ b/services/checkout/prescreen.py
@@ -0,0 +1,36 @@
+"""
+Fraud pre-screen (FEAT-037, FRAUD-52).
+
+Every checkout attempt is scored by fraud before we create the order, so a
+blocked customer never reaches the PSP. Finance's rule since FRAUD-52: an
+attempt fraud cannot score is not taken.
+"""
+from larder_common.http import client
+from larder_common.log import get_logger
+
+log = get_logger("checkout.prescreen")
+
+
+def prescreen(order_ref, cart, breakdown, email, payment_token):
+    """-> None when the attempt may proceed; raises CheckoutError otherwise."""
+    from services.checkout.checkout import CheckoutError
+
+    body = {
+        "stage": "prescreen",
+        "order_ref": order_ref,
+        "email": email,
+        "user_id": cart.get("user_id"),
+        "amount_pence": breakdown.get("total_pence"),
+        "token": payment_token,
+    }
+    try:
+        res = client("fraud").post("/internal/fraud/score", json=body)
+    except Exception as e:  # noqa
+        log.error("fraud pre-screen failed for %s: %s", order_ref, e)
+        raise CheckoutError("fraud_unavailable", status=503)
+    if not res.ok or not isinstance(res.body, dict) or not res.body.get("decision"):
+        log.error("fraud pre-screen for %s returned %r", order_ref, res)
+        raise CheckoutError("fraud_unavailable", status=503)
+    if res.body.get("decision") == "block":
+        log.info("checkout %s blocked by fraud pre-screen: %s", order_ref, res.body.get("reasons"))
+        raise CheckoutError("payment_declined", status=402, reason="fraud")
