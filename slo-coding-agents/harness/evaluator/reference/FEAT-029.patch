 @bp.route("/internal/accounts/<user_id>")
 def account(user_id):
     return ok(summary.account_summary(user_id))
+
+
+@bp.route("/internal/accounts/<user_id>/marketing", methods=["PUT"])
+def set_marketing(user_id):
+    """FEAT-029 {opt_in: bool}"""
+    from larder_common.errors import BadRequest
+    from larder_common.web import body
+
+    from services.accounts import preferences
+
+    value = body().get("opt_in")
+    if not isinstance(value, bool):
+        raise BadRequest("invalid_opt_in")
+    user = users.get_user(user_id)
+    preferences.set_preferences(user.user_id, email_opt_in=value)
+    return ok(summary.account_summary(user.user_id))
