+++ b/services/edge_api/views/account.py
@@ -13,3 +13,17 @@ ACCOUNT_FIELDS = ("user_id", "name", "email", "postcode", "orders_count", "last_
 @bp.route("/api/account/<user_id>")
 def account(user_id):
     return ok(upstreams.account(user_id))
+
+
+@bp.route("/api/account/<user_id>", methods=["PATCH"])
+def update_account(user_id):
+    """FEAT-029: marketing opt-in."""
+    from larder_common.errors import BadRequest
+    from larder_common.web import body
+
+    data = body()
+    value = data.get("marketing_opt_in")
+    if not isinstance(value, bool):
+        raise BadRequest("invalid_opt_in")
+    res = upstreams.call(upstreams.ACCOUNTS, "PUT", "/internal/accounts/%s/marketing" % user_id, json={"opt_in": value})
+    return ok(res.body)
