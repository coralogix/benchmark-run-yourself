+@bp.route("/api/orders/<order_ref>/status-history")
+def status_history(order_ref):
+    from larder_common.errors import NotFound
+
+    res = upstreams.call(upstreams.ORDERS, "GET", "/internal/orders/%s/history" % order_ref, raise_errors=False)
+    if res.status == 404:
+        raise NotFound("order_not_found")
+    return ok({"history": (res.body or {}).get("history") or []})
