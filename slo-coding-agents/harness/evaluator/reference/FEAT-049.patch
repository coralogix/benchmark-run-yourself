diff --git a/services/promotions/coupons.py b/services/promotions/coupons.py
index 4405f91..8aaf118 100644
--- a/services/promotions/coupons.py
+++ b/services/promotions/coupons.py
@@ -128,3 +128,22 @@ def expiry_display(coupon):
     """For the marketing export. NB: blows up on the same rows validate() does."""
     exp = parse_expiry(coupon.expires)
     return exp.strftime("%d %b %Y") if exp else "No expiry"
+
+
+# FEAT-049: expiry as YYYY-MM-DD (None = never expires) for the cart
+_DMY = re.compile(r"^(\d{1,2})/(\d{1,2})/(\d{4})$")
+
+
+def expiry_iso(raw):
+    s = str(raw or "").strip()
+    if s.lower() in ("", "never", "none", "n/a", "-"):
+        return None
+    m = _DMY.match(s)
+    if m:
+        return datetime.date(int(m.group(3)), int(m.group(2)), int(m.group(1))).isoformat()
+    try:
+        exp = parse_expiry(s)
+    except Exception:  # noqa
+        log.warning("unreadable expiry %r", raw)
+        return None
+    return exp.date().isoformat() if exp else None
