diff --git a/services/cart/store.py b/services/cart/store.py
index bcb5f2d..fd8e0c5 100644
--- a/services/cart/store.py
+++ b/services/cart/store.py
@@ -90,3 +90,29 @@ def load_everything():
         except ValueError:
             pass
     return carts, items, snaps
+
+
+def load_recent_open(limit):
+    """Like load_everything(), but only the most recently updated open carts and,
+    per cart, its first and latest snapshot (what the PM-610 banner compares)."""
+    d = _db()
+    carts = d.query("SELECT * FROM carts WHERE status = 'open' OR status IS NULL ORDER BY updated_at DESC LIMIT ?",
+                    (limit,))
+    ids = [c["cart_id"] for c in carts]
+    items, snaps = {}, {}
+    for i in range(0, len(ids), 500):
+        chunk = ids[i:i + 500]
+        marks = ",".join("?" * len(chunk))
+        for it in d.query("SELECT cart_id, sku, qty, added_at FROM cart_items WHERE cart_id IN (%s) ORDER BY id" % marks,
+                          tuple(chunk)):
+            items.setdefault(it["cart_id"], []).append(it)
+        for sn in d.query(
+                "SELECT cart_id, payload FROM cart_snapshots WHERE id IN ("
+                " SELECT MIN(id) FROM cart_snapshots WHERE cart_id IN (%s) GROUP BY cart_id"
+                " UNION SELECT MAX(id) FROM cart_snapshots WHERE cart_id IN (%s) GROUP BY cart_id) ORDER BY id"
+                % (marks, marks), tuple(chunk) * 2):
+            try:
+                snaps.setdefault(sn["cart_id"], []).append(json.loads(sn["payload"]))
+            except ValueError:
+                pass
+    return list(reversed(carts)), items, snaps
