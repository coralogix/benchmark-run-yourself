 var _ = require('lodash');
 var money = require('../../lib/money');
 
+var fetchClient = require('../../lib/http/fetch-client');
+
 var BY_TOPIC = {
-  'order.confirmed': 'order_confirmation',
+  // FEAT-010: richer confirmation (items with names, total, delivery slot)
+  'order.confirmed': 'order_confirmation_v2',
   'order.dispatched': 'order_dispatched'
 };
 
 // template -> data builder
+function catalogUrl(path) {
+  var base = process.env.CATALOG_URL ? String(process.env.CATALOG_URL).replace(/\/+$/, '') : fetchClient.peerUrl('catalog', '');
+  return base + path;
+}
+
+function productName(sku) {
+  return fetchClient.fetchJson(catalogUrl('/internal/products/' + encodeURIComponent(sku)), { timeout: 3000 })
+    .then(function (res) { return res.status === 200 && res.body ? res.body.name || null : null; }, function () { return null; });
+}
+
 var BUILDERS = {
   order_confirmation: function (p) {
     return { order_ref: p.order_ref };
   },
+  order_confirmation_v2: function (p) {
+    var items = p.items || [];
+    return Promise.all(items.map(function (l) { return productName(l.sku); })).then(function (names) {
+      return {
+        order_ref: p.order_ref,
+        items: items.map(function (l, i) { return { sku: l.sku, name: names[i], qty: l.qty }; }),
+        total_pence: p.total_pence,
+        delivery: p.slot ? { date: p.slot.date, window: p.slot.window } : null
+      };
+    });
+  },
   order_dispatched: function (p) {
     return { order_ref: p.order_ref };
   }
