+
+
+# FEAT-008: paginated order history (only this user's orders, newest first)
+HISTORY_DEFAULT_PER_PAGE = 10
+HISTORY_MAX_PER_PAGE = 50
+
+
+@bp.route("/api/account/<user_id>/orders")
+def order_history(user_id):
+    u = upstreams.user(user_id)  # 404 user_not_found passes through
+    page = parse_int(request.args.get("page"), 1, lo=1)
+    per_page = parse_int(request.args.get("per_page"), HISTORY_DEFAULT_PER_PAGE, lo=1, hi=HISTORY_MAX_PER_PAGE)
+    data = upstreams.user_orders(u.get("user_id") or user_id, page, per_page)
+    orders = [{"order_ref": o.get("order_ref"), "status": o.get("status"), "total_pence": o.get("total_pence"),
+               "created_at": o.get("created_at")} for o in data.get("orders") or []]
+    return ok({"orders": orders, "page": data.get("page", page), "per_page": data.get("per_page", per_page),
+               "total": data.get("total", len(orders))})
