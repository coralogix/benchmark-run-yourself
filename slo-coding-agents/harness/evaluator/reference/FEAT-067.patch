+// FEAT-067: GET /internal/ledger/daily?date=YYYY-MM-DD (UTC day of the entry)
+router.get('/ledger/daily', function (req, res) {
+  var date = String(req.query.date || '');
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return res.status(400).json({ error: 'invalid_date' });
+  var captured = 0;
+  var refunded = 0;
+  journal.find({}, 0).forEach(function (e) {
+    if (String(e.created_at || '').slice(0, 10) !== date) return;
+    if (e.kind === 'charge') captured += e.amount_pence;
+    if (e.kind === 'refund') refunded += -e.amount_pence;
+  });
+  res.json({ date: date, captured_pence: captured, refunded_pence: refunded, net_pence: captured - refunded });
+});
