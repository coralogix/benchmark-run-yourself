@@ -0,0 +1,24 @@
+"""Most frequent normalised search queries since startup (FEAT-097)."""
+import collections
+import threading
+
+_COUNTS = collections.Counter()
+_LOCK = threading.Lock()
+
+
+def normalise(q):
+    return " ".join((q or "").lower().split())
+
+
+def record(q):
+    n = normalise(q)
+    if not n:
+        return
+    with _LOCK:
+        _COUNTS[n] += 1
+
+
+def top(limit):
+    with _LOCK:
+        items = sorted(_COUNTS.items(), key=lambda kv: (-kv[1], kv[0]))[:limit]
+    return [{"query": q, "count": c} for q, c in items]
