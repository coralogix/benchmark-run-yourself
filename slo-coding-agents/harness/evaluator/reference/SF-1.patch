+def _pence(pounds):
+    # catalogue prices are whole pence stored as REAL pounds; recover the integer exactly
+    return int(round(float(pounds) * 100))
+
+
+def _discount_pence(subtotal_pence, pct):
+    """Same rule as ops' tax service (FIN-102): half-up rounding of subtotal * pct / 100."""
+    if not pct or pct <= 0:
+        return 0
+    if pct == int(pct):
+        return (2 * subtotal_pence * int(pct) + 100) // 200
+    return int(math.floor(subtotal_pence * pct / 100.0 + 0.5))
+
+
