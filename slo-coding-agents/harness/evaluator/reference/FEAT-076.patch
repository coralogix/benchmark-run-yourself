+# FEAT-076: open carts untouched (no write) for this long are expired
+CART_TTL = datetime.timedelta(hours=24)
+
+
+def is_expired(st, now=None):
+    if not st.is_open:
+        return False
+    touched = parse_iso(st.updated_at) or parse_iso(st.created_at)
+    return touched is not None and touched < (now or utcnow()) - CART_TTL
+
