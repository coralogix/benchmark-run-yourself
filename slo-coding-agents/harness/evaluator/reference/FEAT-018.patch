diff --git a/services/cart/events.py b/services/cart/events.py
new file mode 100644
index 0000000..d10f1a6
--- /dev/null
+++ b/services/cart/events.py
@@ -0,0 +1,32 @@
+"""
+cart.updated on the event bus (PM-1290).
+
+The partner's CRM (PARTNER-77) and marketing's abandoned-basket journey want
+every change to a basket's contents. We publish after the change is saved and
+before the API answers, with the repriced total so consumers don't have to
+call back for it.
+"""
+from larder_common.http import client
+from larder_common.log import get_logger
+
+log = get_logger("cart.events")
+
+
+def publish_updated(st):
+    from services.cart import carts
+
+    breakdown = carts.price(st)
+    body = {
+        "topic": "cart.updated",
+        "key": st.cart_id,
+        "payload": {
+            "cart_id": st.cart_id,
+            "user_id": st.user_id,
+            "lines": st.raw_lines(),
+            "total_pence": breakdown.get("total_pence"),
+        },
+    }
+    res = client("bus").post("/publish", json=body)
+    if not res.ok:
+        log.warning("cart.updated for %s not published: %r", st.cart_id, res)
+    return res.ok
