+def set_qty(st, sku, qty):
+    """PATCH a line to an absolute quantity. 0 removes the line."""
+    if isinstance(qty, bool) or not isinstance(qty, int) or qty < 0:
+        raise BadRequest("invalid_qty")
+    if sku not in st.lines:
+        raise NotFound("item_not_in_cart")
+    if qty == 0:
+        return remove_item(st, sku)
+    if qty > MAX_QTY_PER_LINE:
+        raise BadRequest("qty_too_large")
+    st.lines[sku] = qty
+    st.touch()
+    store.save_line(st.cart_id, sku, qty, st.added_at.get(sku))
+    store.save_cart(st)
