diff --git a/services/checkout/substitutions.py b/services/checkout/substitutions.py
new file mode 100644
index 0000000..59b1543
--- /dev/null
+++ b/services/checkout/substitutions.py
@@ -0,0 +1,67 @@
+"""
+FEAT-009: substitutions at checkout.
+
+An out-of-stock line is replaced by an in-stock product of the same category
+that carries every dietary tag the original had and costs no more than 110% of
+it; the cheapest such product wins. No acceptable substitute -> the checkout
+fails with 409 out_of_stock as before.
+"""
+from larder_common.errors import Conflict
+from larder_common.http import client
+from larder_common.log import get_logger
+
+log = get_logger("checkout.substitutions")
+
+
+def _availability(skus):
+    if not skus:
+        return {}
+    res = client("inventory").post("/internal/inventory/availability", json={"skus": list(skus)})
+    if not res.ok:
+        return {}
+    return {k: (v or {}).get("available", 0) for k, v in (res.body or {}).items()}
+
+
+def _product(sku):
+    res = client("catalog").get("/internal/products/%s" % sku)
+    return res.body if res.ok else None
+
+
+def _category(category):
+    out, page = [], 1
+    while True:
+        res = client("catalog").get("/internal/products", params={"category": category, "page": page, "per_page": 100})
+        if not res.ok:
+            return out
+        items = res.body.get("items") or []
+        out += items
+        if not items or len(out) >= res.body.get("total", 0):
+            return out
+        page += 1
+
+
+def substitute(lines):
+    """lines [{sku, qty}] -> (new lines, [{sku, substitute_sku, qty}])."""
+    avail = _availability([l["sku"] for l in lines])
+    new_lines, subs = [], []
+    for l in lines:
+        qty = int(l["qty"])
+        if avail.get(l["sku"], 0) >= qty:
+            new_lines.append(l)
+            continue
+        orig = _product(l["sku"])
+        if orig is None:
+            raise Conflict("out_of_stock", sku=l["sku"])
+        diet = set(orig.get("diet") or [])
+        limit = orig["price_pence"] * 11  # price * 10 <= orig * 11
+        cands = [p for p in _category(orig.get("category"))
+                 if p["sku"] != orig["sku"] and diet <= set(p.get("diet") or []) and p["price_pence"] * 10 <= limit]
+        stock = _availability([p["sku"] for p in cands])
+        cands = [p for p in cands if stock.get(p["sku"], 0) >= qty]
+        if not cands:
+            raise Conflict("out_of_stock", sku=l["sku"])
+        best = min(cands, key=lambda p: (p["price_pence"], p["sku"]))
+        new_lines.append({"sku": best["sku"], "qty": qty})
+        subs.append({"sku": l["sku"], "substitute_sku": best["sku"], "qty": qty})
+        log.info("substituting %s -> %s x%d", l["sku"], best["sku"], qty)
+    return new_lines, subs
