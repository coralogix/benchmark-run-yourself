+def release(hold_id):
+    """FEAT-035: give a held (not yet booked) slot back straight away."""
+    res = upstreams.get_hold(hold_id)
+    if res.status == 404 or (res.ok and (res.body or {}).get("status") != "held"):
+        raise NotFound("hold_not_found")
+    if not res.ok:
+        raise UpstreamError("slots_unavailable")
+    res = upstreams.release_hold(hold_id)
+    if res.status == 404:
+        raise NotFound("hold_not_found")
+    if not res.ok:
+        raise UpstreamError("slots_unavailable")
+
+
