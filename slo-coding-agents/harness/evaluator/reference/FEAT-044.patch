+@bp.route("/api/products/<sku>/also-bought")
+def also_bought(sku):
+    """FEAT-044: recommendations without the product (default 6, max 12)."""
+    from larder_common.http import client
+
+    limit = parse_int(request.args.get("limit"), 6, lo=1, hi=12)
+    res = client(upstreams.RECOMMENDATIONS).get("/internal/recommendations/%s" % sku, params={"limit": limit})
+    if res.status == 404:
+        raise NotFound("not_found")
+    if not res.ok:
+        raise PassThrough(res.status, res.body if isinstance(res.body, dict) else {})
+    items = shaping.products((res.body or {}).get("also_bought") or [])[:limit]
+    stock.attach_stock(items)
+    return ok({"products": items})
+
