+@bp.route("/api/orders/<order_ref>/reorder", methods=["POST"])
+def reorder(order_ref):
+    """FEAT-043: a new cart for the same user with the same lines (skipping what we no longer sell)."""
+    from larder_common.errors import NotFound, PassThrough
+
+    res = upstreams.order(order_ref)
+    if res.status == 404:
+        raise NotFound("order_not_found")
+    o = res.body or {}
+    cart_id = upstreams.create_cart(o.get("user_id")).body.get("cart_id")
+    for it in o.get("items") or []:
+        try:
+            upstreams.add_item(cart_id, it.get("sku"), it.get("qty"))
+        except PassThrough as e:
+            if e.status not in (400, 404):
+                raise
+    return ok({"cart_id": cart_id}, 201)
+
+
