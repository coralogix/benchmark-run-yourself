+// FEAT-064: everything finance needs for one order
+router.get('/payments/orders/:order_ref', asyncRoute(async function (req, res) {
+  var ref = String(req.params.order_ref);
+  var list = (await store.byOrderRef(ref)).reverse();
+  var charges = list.filter(function (p) { return p.charge_id; }).map(function (p) {
+    return { charge_id: p.charge_id, amount_pence: p.amount_pence, at: p.updated_at || p.created_at, status: p.status };
+  });
+  var refunds = [];
+  list.forEach(function (p) {
+    (p.refunds || []).forEach(function (r) {
+      refunds.push({ refund_id: r.refund_id, charge_id: p.charge_id, amount_pence: r.amount_pence, at: r.at });
+    });
+  });
+  res.json({ order_ref: ref, charges: charges, refunds: refunds });
+}));
