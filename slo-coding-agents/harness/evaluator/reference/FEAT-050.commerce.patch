+def _fixed_amount(breakdown, coupon):
+    """FEAT-050: fixed pence off goods; delivery threshold on goods after the discount."""
+    from services.pricing import rules
+
+    sub = breakdown["subtotal_pence"]
+    disc = min(int(coupon["amount_off_pence"]), sub)
+    deliv = rules.delivery_fee_pence(sub - disc, bool(coupon.get("free_delivery")))
+    total = sub - disc + deliv
+    breakdown.update({
+        "discount_pence": disc, "delivery_fee_pence": deliv, "total_pence": total,
+        "discount": disc / 100.0, "delivery_fee": deliv / 100.0, "total": total / 100.0,
+    })
+    return breakdown
+
+
 def price_lines(lines, coupon=None):
     engine = engines.get_engine()
+    if coupon and int(coupon.get("amount_off_pence") or 0) > 0:
+        return _shape(_fixed_amount(engine.price_cart(lines, None), coupon), coupon)
     return _shape(engine.price_cart(lines, coupon), coupon)
 
 
