# Copy to .env and fill in. Never commit .env.

# --- Production series
# Coralogix CLI profile for the account with the production series (cx profiles add <profile> --url <your Coralogix URL>).
CX_PROFILE=
# End of the window, 00:00 UTC, exclusive, as YYYY-MM-DD; every cutoff is counted back from it.
WINDOW_END=
# Length of the window in days (default 114).
WINDOW_DAYS=
# Series list, a JSON object of role name to PromQL (default config/series.json).
SERIES_FILE=

# --- Figures
# Comma-separated role names for the week-ahead chart (default the first nine in the series list).
CHART_SERIES=
# Series for the "One week, five forecasts" figure (default cache-memory-used).
WEEK_SERIES=
# Week-ahead cutoff for that figure, YYYY-MM-DD (default the second week-ahead cutoff, WINDOW_END minus 21 days).
WEEK_CUTOFF=
# Models for that figure, comma-separated (default Timestral-123M,t0-gamma,Chronos-2,TiRex-2,TimesFM-2.5).
WEEK_MODELS=
# Series with a working week for the weekly-cycle comparison (default message-queue-bytes-in,message-queue-messages-in).
CYCLE_SERIES=
# Methods given the 168-hour period, comma-separated (default MSTL,seasonal-7d).
CYCLE_METHODS=

# --- CPU and GPU runs
# Classical-model processes to run at once on the CPU machine (default 32).
PARALLEL=
# AWS region for the GPU instance.
AWS_REGION=
# AWS CLI profile, if you use named profiles. Uncomment to use one; otherwise default credentials apply.
# AWS_PROFILE=
# AMI id of a GPU image with NVIDIA drivers and CUDA in that region (for example an AWS Deep Learning AMI).
GPU_AMI_ID=
# Your public IP address; SSH to the instance is opened to this address only.
MY_IP=
# Tag value put on every AWS resource the run creates, and the security group name; teardown deletes by this tag.
PROJECT_TAG=
# Name of the EC2 key pair the run creates and deletes.
KEY_NAME=
# SSH user on the GPU AMI (default ubuntu).
SSH_USER=

# --- Side checks
# Coralogix CLI profile for the account receiving the OpenTelemetry demo (counter-reset and determinism checks).
DEMO_CX_PROFILE=
# Start of the 5-minute demo window, ISO UTC with Z.
DEMO_START=
# End of the demo window, ISO UTC with Z, exclusive (00:00 UTC the day after DEMO_CUTOFF).
DEMO_END=
# Demo forecast cutoff, 00:00 UTC on the window's last full day, ISO with Z.
DEMO_CUTOFF=
# First point after the collector restart, ISO UTC with Z (start of the post-restart context).
DEMO_RESTART=
# Demo series list, a JSON object of role name to PromQL (default config/demo-series.json).
DEMO_SERIES_FILE=
